{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@src/*": ["./src/*"]
    },
    "target": "es6",
    "module": "nodenext",
    "allowJs": true,
    "jsx": "react",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./temp/tsc-build"
  },  
  "include": ["src", "custom.d.ts"]
}
